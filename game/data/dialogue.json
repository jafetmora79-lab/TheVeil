 "c5_eddie_morning": {
  "source": "Chapter 5 implementation prompt 01 (approved script)",
  "lines": [
   {
    "speaker": "Eddie",
    "text": "Morning. Or whatever we're calling it.",
    "time": 3.3
   },
   {
    "speaker": "",
    "text": "Did you sleep?",
    "time": 1.8
   },
   {
    "speaker": "Eddie",
    "text": "Not really. Every time the building made a noise, I thought something was coming through the doors.",
    "time": 7.0
   },
   {
    "speaker": "",
    "text": "We need more supplies.",
    "time": 2.3
   },
   {
    "speaker": "Eddie",
    "text": "Yeah. I checked what we have left. It's not great.",
    "time": 4.0
   },
   {
    "speaker": "",
    "text": "There's a neighborhood close by.",
    "time": 2.9
   },
   {
    "speaker": "Eddie",
    "text": "You're suggesting we go outside again.",
    "time": 3.3
   },
   {
    "speaker": "",
    "text": "We don't have much choice.",
    "time": 2.5
   },
   {
    "speaker": "Eddie",
    "text": "Right. Great. Love having choices.",
    "time": 3.0
   }
  ]
 },
 "c5_marcus_morning": {
  "source": "Chapter 5 implementation prompt 01 (approved script)",
  "lines": [
   {
    "speaker": "Marcus",
    "text": "I've been looking at the streets around here.",
    "time": 3.7
   },
   {
    "speaker": "",
    "text": "Find anything?",
    "time": 1.8
   },
   {
    "speaker": "Marcus",
    "text": "Not yet. But Noah knew this part of town. He could've gone somewhere familiar.",
    "time": 5.7
   },
   {
    "speaker": "",
    "text": "We're going to look for supplies first.",
    "time": 3.3
   },
   {
    "speaker": "Marcus",
    "text": "I know.",
    "time": 1.8
   },
   {
    "speaker": "Marcus",
    "text": "Just... if you see anything. Anything that might belong to him.",
    "time": 4.8
   },
   {
    "speaker": "",
    "text": "I'll keep an eye out.",
    "time": 2.2
   },
   {
    "speaker": "Marcus",
    "text": "Thank you.",
    "time": 1.8
   }
  ]
 },
