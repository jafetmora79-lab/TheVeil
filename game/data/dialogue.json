 "p4_talk": {
  "lines": [
   {
    "speaker": "Marcus",
    "text": "Lights are on. Good. Then I'm going back out.",
    "time": 3.0
   },
   {
    "speaker": "Eddie",
    "text": "Out where? You saw what's out there.",
    "time": 2.6
   },
   {
    "speaker": "Marcus",
    "text": "My son is out there. Every minute I wait is a minute he's alone.",
    "time": 3.6
   },
   {
    "speaker": "Eddie",
    "text": "And out there you can't see your own hand. You'd be walking around blind.",
    "time": 3.6
   },
   {
    "speaker": "Marcus",
    "text": "Then what? We sit here eating chips while he's-",
    "time": 3.2
   },
   {
    "speaker": "Eddie",
    "text": "Hey. Hey. Ask them. You were out there too.",
    "time": 3.0
   }
  ],
  "choices": [
   {
    "text": "\"We should wait until morning.\"",
    "next": "p4_choice_wait",
    "flag": "p4_choice_wait"
   },
   {
